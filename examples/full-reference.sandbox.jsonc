{
  // ==========================================================================
  // sandbox.json — full option reference (JSONC: comments allowed)
  //
  // Locations: ~/.pi/agent/sandbox.json (global) and <project>/.pi/sandbox.json
  // (project overlay, honored only when the project is trusted).
  // Lists merge (concat); scalars (mode, tools.default, commands.proxies)
  // override: project > global > built-in default. Denies always win.
  // ==========================================================================

  // "enforce" = apply policy. "off" = allow everything.
  // Toggle: /sandbox on|off. One-off bypass: pi --no-sandbox.
  "mode": "enforce",

  "tools": {
    // Tool-name allowlist (command-glob: `*` matches any text).
    // Custom tools listed here run without prompting. Built-ins listed here
    // STILL get command/path checks — a name gate, not an exemption.
    "allow": [
      "ctx_search"
    ],
    // Tool-name denylist, checked first. Use it for extension-registered
    // tools that execute LLM-written code, or to disable a built-in.
    "deny": [
      "ctx_execute",
      "mcp_*"
      // "bash"                 // nuclear option: disable shell access
    ],
    // Verdict for CUSTOM tools in neither list: "allow" (default) or "ask".
    // Built-ins are unaffected (they always use command/path policy).
    "default": "allow"
  },

  "commands": {
    // Bash allowlist. Commands split on && || ; | — EVERY segment must pass.
    // `*` matches any text (incl. slashes). Trailing " *" also matches the
    // bare command ("git push *" denies bare "git push").
    "allow": [
      "./gradlew *",
      "git status",
      "git diff *",
      "npm *"
    ],
    // Bash denylist, checked BEFORE allow — carve exceptions out of broad
    // allows. Hard-denied by the extension and non-overridable:
    // eval *, bash -c *, sh -c *, sudo *, rm -rf /, rm -rf ~*, mkfs*,
    // dd *of=/dev/*
    "deny": [
      "git push *",
      "rm -rf *"
    ],
    // Proxy binaries unwrapped before matching: "rtk git push" is checked as
    // both "rtk git push" and "git push" (deny on any form wins, allow on
    // any form passes). OVERRIDE semantics — this replaces the default
    // ["rtk"], it does not append. [] disables unwrapping.
    "proxies": ["rtk"]
  },

  "paths": {
    // Path allowlist for read/write/edit/grep/find/ls AND path-like tokens
    // in bash commands (incl. cd targets). `*` = one segment, `**` = any
    // depth. ~ expands; relative patterns resolve against the session cwd;
    // patterns starting with **/ match anywhere. Default when empty: ["./**"]
    "allow": [
      "./**",
      "~/Projects/**"
    ],
    // Path denylist, checked first. Built-in defaults (always active):
    // **/.env, **/.env.*, **/.git/**, **/.ssh/**, **/id_rsa*, **/*.pem
    "deny": [
      "**/*.jks",
      "**/secrets/**"
    ]
  },

  // Kernel-level boundary for bash commands (pattern-matching guardrail
  // still applies to everything; bwrap only wraps bash). Requires bwrap
  // installed + unprivileged user namespaces. Probed once per session.
  "bwrap": {
    "enabled": true,       // master switch
    "autoAllow": false,    // true: bash asks run sandboxed WITHOUT prompting
                           // (denies never downgrade; file-tool asks unaffected)
    "network": "allow",    // "allow" | "off" (--unshare-net)
    "allowWrite": [        // extra writable paths (build caches); missing skipped
      "~/.gradle", "~/.m2", "~/.npm", "~/.cache"
    ],
    "denyRead": [          // hidden: tmpfs over dirs, /dev/null over files
      "~/.ssh", "~/.aws", "~/.gnupg", "~/.kube", "~/.docker/config.json"
    ],
    "maskEnv": [           // env vars (glob by name) unset inside the sandbox
      "AWS_*", "GITHUB_TOKEN", "*_API_KEY", "*_SECRET*"
    ],
    "fallback": "ask",     // bwrap unavailable: "ask" = degrade to guardrail,
                           // "block" = fail bash closed
    "userBash": false      // also sandbox your own ! / !! commands
  }
}
