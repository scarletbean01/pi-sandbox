{
  "name": "pi-sandbox-extension",
  "version": "1.0.0",
  "private": true,
  "description": "Configurable guardrails for pi: allowlist/denylist/ask policy for bash commands and filesystem paths",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "picomatch": "4.0.5",
    "tree-sitter-bash": "0.25.1",
    "web-tree-sitter": "0.27.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.81.1",
    "@earendil-works/pi-tui": "0.81.1",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && bun test"
  }
}
